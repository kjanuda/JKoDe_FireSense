        "title": "ArtifactIntegritySummary"
      },
      "CoefficientDerivationInfo": {
        "properties": {
          "formula": {
            "type": "string",
            "const": "V = K / tau",
            "title": "Formula"
          },
          "coefficient_k": {
            "type": "number",
            "title": "Coefficient K"
          },
          "exponent": {
            "type": "number",
            "const": -1.0,
            "title": "Exponent",
            "default": -1.0
          },
          "fit_space": {
            "type": "string",
            "const": "natural_log",
            "title": "Fit Space",
            "default": "natural_log"
          },
          "derivation": {
            "type": "string",
            "title": "Derivation"
          },
          "contributing_record_count": {
