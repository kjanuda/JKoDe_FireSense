{
  "openapi": "3.1.0",
  "info": {
    "title": "FireSense API",
    "description": "Evidence-grounded reduced-gravity fire behavior intelligence and decision-support API.",
    "version": "0.1.0"
  },
  "paths": {
    "/api/predict/fire-behavior": {
      "post": {
        "tags": [
          "Fire Behavior Prediction"
        ],
        "summary": "Predict PMMA thin-sheet flame spread",
        "description": "Exploratory FireSense Physics Baseline v0. Predicts flame spread rate only inside the empirically supported Figure 2.21 domain. Requests outside the supported scientific scope return an explicit abstention.",
        "operationId": "predict_fire_behavior_api_predict_fire_behavior_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/FireBehaviorPredictionRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FireBehaviorPredictionResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/predict/fire-behavior/explain": {
      "post": {
        "tags": [
          "Fire Behavior Prediction"
        ],
        "summary": "Predict and return evidence trace",
        "description": "Returns the FireSense prediction or abstention together with the frozen dataset identity, artifact integrity verification, canonical Figure 2.21 evidence, coefficient derivation, nearby observations, provenance policy, and uncertainty limitations.",
        "operationId": "explain_fire_behavior_prediction_api_predict_fire_behavior_explain_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/FireBehaviorPredictionRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExplainedPredictionResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/recommendations/next-experiment": {
      "get": {
        "tags": [
          "Experiment Recommendation"
        ],
        "summary": "Return the current next-experiment research candidate",
        "description": "Returns the frozen FireSense v0 research-priority matched-pair experiment candidate together with the coverage/Bayesian agreement, posterior uncertainty, evidence provenance, integrity verification, and scientific guardrails. This endpoint does not approve an experiment and does not refit the Bayesian model at request time.",
        "operationId": "get_next_experiment_api_recommendations_next_experiment_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NextExperimentRecommendationResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/recommendations/next-experiment/explain": {
      "get": {
        "tags": [
          "Experiment Recommendation"
        ],
        "summary": "Explain why the next experiment is prioritized",
        "description": "Provides a human-readable scientific explanation of the frozen FireSense next-experiment decision, including the evidence chain, coverage/Bayesian agreement, posterior uncertainty, model limitations, and approval guardrails. No model is refitted at request time.",
        "operationId": "explain_next_experiment_api_recommendations_next_experiment_explain_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NextExperimentExplanationResponse"
                }
              }
            }
          }
        }
      }
    },
    "/": {
      "get": {
        "tags": [
          "System"
        ],
        "summary": "Root",
        "operationId": "root__get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/health": {
      "get": {
        "tags": [
          "System"
        ],
        "summary": "Health",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
