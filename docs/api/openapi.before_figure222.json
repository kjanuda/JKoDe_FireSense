      },
      "FireBehaviorPredictionRequest": {
        "properties": {
          "material": {
            "type": "string",
            "minLength": 1,
            "title": "Material",
            "examples": [
              "PMMA"
            ]
          },
          "geometry": {
            "type": "string",
            "minLength": 1,
            "title": "Geometry",
            "examples": [
              "thin_sheet"
            ]
          },
          "thickness_um": {
            "type": "number",
            "exclusiveMinimum": 0.0,
            "title": "Thickness Um",
            "examples": [
              200.0
            ]
          },
          "gravity_regime": {
            "type": "string",
            "enum": [
              "microgravity",
              "normal_gravity"
            ],
            "title": "Gravity Regime"
          },
          "oxygen_fraction": {
            "type": "number",
            "maximum": 1.0,
            "exclusiveMinimum": 0.0,
            "title": "Oxygen Fraction",
            "examples": [
              0.21
            ]
          },
          "pressure_kpa": {
            "type": "number",
            "exclusiveMinimum": 0.0,
            "title": "Pressure Kpa",
            "examples": [
              101.325
            ]
          }
