          },
          "bayesian_candidate_um": {
            "type": "number",
            "title": "Bayesian Candidate Um"
          },
          "absolute_difference_um": {
            "type": "number",
            "title": "Absolute Difference Um"
          },
          "relative_difference_percent": {
            "type": "number",
            "title": "Relative Difference Percent"
          },
          "within_one_percent": {
            "type": "boolean",
            "title": "Within One Percent"
          }
        },
        "type": "object",
        "required": [
          "coverage_candidate_um",
          "bayesian_candidate_um",
          "absolute_difference_um",
          "relative_difference_percent",
          "within_one_percent"
        ],
