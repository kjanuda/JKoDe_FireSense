          },
          "contributing_record_ids": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Contributing Record Ids"
          }
        },
        "type": "object",
        "required": [
          "formula",
          "coefficient_k",
          "derivation",
          "contributing_record_count",
          "contributing_record_ids"
        ],
