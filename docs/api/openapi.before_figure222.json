          },
          "abstention_reasons": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Abstention Reasons",
            "default": []
          },
          "supported_domain": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/SupportedDomain"
              },
              {
                "type": "null"
              }
            ]
          },
          "model": {
            "$ref": "#/components/schemas/PredictionModelInfo"
          },
          "descriptive_residual_factor": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Descriptive Residual Factor"
          },
          "uncertainty_note": {
