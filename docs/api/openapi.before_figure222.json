          "material",
          "geometry",
          "thickness_um",
          "gravity_regime",
          "oxygen_fraction",
          "pressure_kpa"
        ],
        "title": "FireBehaviorPredictionRequest"
      },
      "FireBehaviorPredictionResponse": {
        "properties": {
          "decision": {
            "type": "string",
            "enum": [
              "predict",
              "abstain"
            ],
            "title": "Decision"
          },
          "prediction": {
            "anyOf": [
